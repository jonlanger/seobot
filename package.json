{
  "name": "seobot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-study-facts.mjs && tsc && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:seo-check": "node scripts/check-seo-check.mjs",
    "data:top-sites": "node scripts/build-top-sites-data.mjs",
    "data:umbrella": "node scripts/pull-umbrella.mjs",
    "data:crux": "node scripts/pull-crux.mjs",
    "data:openpagerank": "node scripts/pull-openpagerank.mjs",
    "data:ai-discovery-radar": "node scripts/pull-ai-discovery-radar.mjs",
    "data:company-profiles": "node scripts/pull-company-profiles.mjs",
    "data:wayback": "node scripts/pull-wayback.mjs",
    "data:site-signals": "node scripts/pull-site-signals.mjs",
    "data:agent-readiness": "node scripts/pull-agent-readiness.mjs",
    "data:structured": "node scripts/derive-structured-data.mjs --study src/content/data/top-sites-study-1k.json",
    "data:top-sites-1k": "node scripts/build-top-sites-data.mjs --list tools/crawl/data/top-1000.json --results tools/crawl/out/results-1k.json --out src/content/data/top-sites-study-1k.json",
    "data:factor-measurements": "node scripts/derive-factor-measurements.mjs",
    "data:study-facts": "node scripts/build-study-facts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@types/three": "^0.186.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
